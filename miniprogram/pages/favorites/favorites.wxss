/* pages/favorites/favorites.wxss */
.fav-page {
  min-height: 100vh;
  background: var(--cure-bg-page);
  padding-bottom: 120rpx;
}

/* ── Not Logged In ── */
.not-logged-in {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 32rpx;
  color: var(--cure-text-secondary);
}

/* ── Loading / Empty ── */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-wrap {
  padding: 80rpx 0;
}

/* ── Manage Bar ── */
.manage-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
}

.fav-count {
  font-size: 26rpx;
  color: var(--cure-text-secondary);
}

.manage-btn {
  font-size: 26rpx;
  color: var(--cure-primary);
  font-weight: 500;
}

/* ── Product Grid (2-column) ── */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx;
}

.product-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: var(--cure-radius-lg);
  overflow: hidden;
  box-shadow: var(--cure-shadow-sm);
  position: relative;
  transition: transform 0.15s;
}

.product-card:active {
  transform: scale(0.98);
}

.product-card.manage {
  opacity: 0.95;
}

/* ── Selection Icon ── */
.select-icon {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.select-icon.selected {
  background: var(--cure-primary);
  border-color: var(--cure-primary);
}

.product-img {
  width: 100%;
  height: 340rpx;
  background: #f5f5f5;
}

.product-info {
  padding: 16rpx 20rpx 20rpx;
  position: relative;
}

.product-name {
  font-size: 26rpx;
  color: var(--cure-text-primary);
  line-height: 1.4;
  min-height: 68rpx;
}

.product-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 8rpx;
}

.product-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.product-sales {
  font-size: 20rpx;
  color: var(--cure-text-placeholder);
}

/* ── Unfavorite Button ── */
.unfav-btn {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Bottom Action Bar ── */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 90;
}

.select-all-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--cure-text-primary);
}

.select-all-btn .select-icon {
  position: static;
}
