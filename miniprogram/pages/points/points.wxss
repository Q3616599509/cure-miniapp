/* pages/points/points.wxss */
.points-page {
  min-height: 100vh;
  background: var(--cure-bg-page);
  padding-bottom: 120rpx;
}

/* ── Not Logged In ── */
.not-logged-in {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 32rpx;
  color: var(--cure-text-secondary);
}

/* ── Points Header ── */
.points-header {
  position: relative;
  overflow: hidden;
  padding: 48rpx 32rpx;
}

.points-header-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, var(--cure-primary) 0%, var(--cure-primary-light) 100%);
}

.points-header-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.points-balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.points-balance-value {
  font-size: 80rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  margin: 8rpx 0;
}

.points-multiplier {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ── Section ── */
.section {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--cure-radius-lg);
  padding: 28rpx;
  box-shadow: var(--cure-shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
  margin-bottom: 20rpx;
}

/* ── Rules ── */
.rules-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
}

.rule-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-content {
  flex: 1;
}

.rule-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cure-text-primary);
}

.rule-desc {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
  margin-top: 4rpx;
}

/* ── Exchange List ── */
.exchange-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}

.exchange-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: var(--cure-radius-lg);
  padding: 20rpx;
  box-shadow: var(--cure-shadow-sm);
  display: flex;
  flex-direction: column;
}

.exchange-img {
  width: 100%;
  height: 160rpx;
  border-radius: var(--cure-radius-md);
  background: #faf8f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.exchange-info {
  display: flex;
  flex-direction: column;
}

.exchange-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--cure-text-primary);
  min-height: 64rpx;
  line-height: 1.4;
}

.exchange-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 4rpx;
}

.exchange-points {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cure-primary);
}

.exchange-cash {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
}

/* ── History ── */
.history-list {
  padding: 16rpx 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: var(--cure-radius-md);
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--cure-shadow-sm);
}

.history-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cure-text-primary);
}

.history-time {
  font-size: 22rpx;
  color: var(--cure-text-placeholder);
  margin-top: 4rpx;
}

.history-points {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cure-error);
}

/* ── Bottom Button ── */
.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 90;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
