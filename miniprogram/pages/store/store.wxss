/* pages/store/store.wxss — 增强版门店选择 */
.store-page { min-height: 100vh; background: var(--cure-bg-page); }

/* ── Location Bar ── */
.location-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx; background: #fff;
  border-bottom: 1rpx solid var(--cure-border-color);
}
.location-bar-left { display: flex; align-items: center; gap: 8rpx; }
.location-bar-right {
  display: flex; align-items: center; gap: 4rpx;
  font-size: 24rpx; color: var(--cure-primary);
  padding: 6rpx 16rpx; border-radius: var(--cure-radius-full);
  background: rgba(131, 92, 69, 0.08);
}
.location-text { font-size: 26rpx; color: var(--cure-text-secondary); }
.location-text--error { color: #999; }
.location-text--warn { color: #f0a020; }

/* ── Map ── */
.map-container { position: relative; width: 100%; height: 440rpx; }
.map { width: 100%; height: 100%; }
.map-overlay {
  position: absolute; bottom: 20rpx; left: 50%; transform: translateX(-50%);
  background: rgba(255,255,255,0.95); padding: 10rpx 28rpx;
  border-radius: var(--cure-radius-full); box-shadow: var(--cure-shadow-md);
}
.map-overlay-text { font-size: 24rpx; color: var(--cure-primary); font-weight: 500; }

/* ── Location Info Bar (below map) ── */
.location-info-bar {
  background: #f5f5f5; padding: 8rpx 24rpx;
  text-align: center;
}
.location-info-bar-text { font-size: 22rpx; color: #888; }

/* ── Far Warning Bar ── */
.location-far-warning-bar {
  background: #fff9e6; padding: 12rpx 24rpx;
  display: flex; align-items: center; gap: 8rpx;
  font-size: 24rpx; color: #e6a23c; line-height: 1.5;
}

/* ── Search ── */
.search-bar { background: #fff; padding: 0 16rpx; }

/* ── Sort Tabs ── */
.sort-tabs { display: flex; padding: 8rpx 20rpx 16rpx; gap: 12rpx; }
.sort-tab {
  font-size: 24rpx; color: var(--cure-text-secondary);
  padding: 8rpx 20rpx; border-radius: var(--cure-radius-full);
  background: var(--cure-bg-page); transition: all 0.2s;
}
.sort-tab--active {
  color: #fff; background: var(--cure-primary);
}

/* ── Store List ── */
.store-list { padding: 0 16rpx 16rpx; }
.loading-wrap { display: flex; justify-content: center; padding: 80rpx 0; }

.store-card {
  background: #fff; border-radius: var(--cure-radius-lg);
  padding: 28rpx; margin-bottom: 16rpx;
  box-shadow: var(--cure-shadow-sm); transition: all 0.15s;
  border: 2rpx solid transparent;
}
.store-card--selected { border-color: var(--cure-primary); }
.store-card:active { transform: scale(0.98); }

.store-card-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.store-card-name {
  font-size: 32rpx; font-weight: 600; color: var(--cure-text-primary);
  flex: 1; margin-right: 16rpx;
}
.store-card-check { color: var(--cure-primary); }

.store-card-address {
  display: flex; align-items: center; margin-bottom: 16rpx;
}
.store-card-address-text {
  flex: 1; font-size: 26rpx; color: var(--cure-text-secondary); margin-left: 8rpx;
}

.store-card-meta {
  display: flex; align-items: center; gap: 28rpx; flex-wrap: wrap;
}
.store-card-distance, .store-card-hours, .store-card-nav {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 24rpx; color: var(--cure-text-secondary);
}
.store-card-distance { color: var(--cure-primary); font-weight: 500; }
.store-card-nav {
  color: #07C160; font-weight: 500; margin-left: auto;
}
