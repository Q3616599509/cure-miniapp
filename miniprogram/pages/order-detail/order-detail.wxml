<!--pages/order-detail/order-detail.wxml — 订单详情页-->
<view class="order-detail-page" wx:if="{{!loading && order}}">

  <!-- ═══ 订单状态头 ═══ -->
  <view class="status-header" style="background: linear-gradient(135deg, {{statusConfig.color}}, {{statusConfig.color}}dd);">
    <view class="status-header__icon">
      <t-icon name="{{statusConfig.icon}}" size="64rpx" color="#fff" />
    </view>
    <view class="status-header__info">
      <text class="status-header__label">{{statusConfig.label}}</text>
      <text class="status-header__desc">{{statusConfig.desc}}</text>
    </view>
  </view>

  <!-- ═══ 取餐码 (自取订单) ═══ -->
  <view class="pickup-code card" wx:if="{{order.pickup_code && order.status !== 'completed' && order.status !== 'cancelled'}}">
    <text class="pickup-code__label">取餐码</text>
    <text class="pickup-code__code">{{order.pickup_code}}</text>
    <text class="pickup-code__tip">请到门店出示此取餐码</text>
  </view>

  <!-- ═══ 门店信息 (自取订单) ═══ -->
  <view class="store-section card" wx:if="{{store}}">
    <view class="section-title">门店信息</view>
    <view class="store-info">
      <view class="store-info__name">{{store.name}}</view>
      <view class="store-info__address">{{store.address}}</view>
      <view class="store-info__row">
        <text class="store-info__phone">电话：{{store.phone}}</text>
        <text class="store-info__hours">营业：{{store.hours}}</text>
      </view>
    </view>
  </view>

  <!-- ═══ 收货地址 (配送订单) ═══ -->
  <view class="address-section card" wx:if="{{address}}">
    <view class="section-title">收货信息</view>
    <view class="address-info">
      <view class="address-info__user">
        <text class="address-info__name">{{address.name}}</text>
        <text class="address-info__phone">{{address.phone}}</text>
      </view>
      <text class="address-info__detail">
        {{address.province}}{{address.city}}{{address.district}}{{address.detail}}
      </text>
    </view>
  </view>

  <!-- ═══ 状态时间线 ═══ -->
  <view class="timeline-section card">
    <view class="section-title">订单进度</view>
    <view class="timeline">
      <view
        wx:for="{{timeline}}"
        wx:key="index"
        class="timeline-item {{item.done ? 'timeline-item--done' : ''}}"
      >
        <view class="timeline-item__dot {{item.active ? 'timeline-item__dot--active' : ''}} {{item.isCancel ? 'timeline-item__dot--cancel' : ''}}"></view>
        <view class="timeline-item__line" wx:if="{{index < timeline.length - 1}}"></view>
        <view class="timeline-item__content">
          <text class="timeline-item__label {{item.active ? 'timeline-item__label--active' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══ 商品列表 ═══ -->
  <view class="items-section card">
    <view class="section-title">商品清单</view>
    <view
      wx:for="{{order.items}}"
      wx:key="id"
      class="order-item"
    >
      <t-image
        src="{{item.image}}"
        mode="aspectFill"
        width="120rpx"
        height="120rpx"
        shape="round"
        lazy
      />
      <view class="order-item__info">
        <text class="order-item__name text-ellipsis-2">{{item.product_name}}</text>
        <text class="order-item__spec" wx:if="{{item.spec_text}}">{{item.spec_text}}</text>
        <view class="order-item__bottom">
          <text class="order-item__price">¥{{item.price}}</text>
          <text class="order-item__qty">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══ 价格明细 ═══ -->
  <view class="price-detail card">
    <view class="price-detail__row">
      <text>商品总价</text>
      <text>¥{{order.total_amount}}</text>
    </view>
    <view class="price-detail__row" wx:if="{{order.discount_amount > 0}}">
      <text>优惠减免</text>
      <text class="text-danger">-¥{{order.discount_amount}}</text>
    </view>
    <view class="price-detail__row">
      <text>配送费</text>
      <text wx:if="{{order.delivery_fee > 0}}">¥{{order.delivery_fee}}</text>
      <text wx:else class="text-danger">免运费</text>
    </view>
    <view class="price-detail__row" wx:if="{{order.points_earned > 0 && order.status !== 'pending_payment'}}">
      <text>获得积分</text>
      <text class="text-primary">+{{order.points_earned}}</text>
    </view>
    <view class="divider" style="margin: 16rpx 0;"></view>
    <view class="price-detail__row price-detail__row--total">
      <text>实付金额</text>
      <view class="price-detail__total">
        <text class="price-symbol text-primary">¥</text>
        <text class="price-detail__total-num text-primary">{{order.pay_amount}}</text>
      </view>
    </view>
  </view>

  <!-- ═══ 订单信息 ═══ -->
  <view class="order-info card">
    <view class="section-title">订单信息</view>
    <view class="order-info__row" bindtap="onCopyOrderNo">
      <text class="order-info__label">订单编号</text>
      <view class="order-info__value">
        <text class="order-info__text">{{order.order_no}}</text>
        <text class="order-info__copy">复制</text>
      </view>
    </view>
    <view class="order-info__row">
      <text class="order-info__label">下单时间</text>
      <text class="order-info__text">{{order.created_at}}</text>
    </view>
    <view class="order-info__row" wx:if="{{order.paid_at}}">
      <text class="order-info__label">支付时间</text>
      <text class="order-info__text">{{order.paid_at}}</text>
    </view>
    <view class="order-info__row" wx:if="{{order.completed_at}}">
      <text class="order-info__label">完成时间</text>
      <text class="order-info__text">{{order.completed_at}}</text>
    </view>
    <view class="order-info__row" wx:if="{{order.remark}}">
      <text class="order-info__label">订单备注</text>
      <text class="order-info__text">{{order.remark}}</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 140rpx;"></view>

  <!-- ═══ 底部操作栏 ═══ -->
  <view class="action-bar safe-bottom-fixed" wx:if="{{order.status !== 'completed' && order.status !== 'cancelled'}}">
    <button class="action-bar__share" open-type="share">
      <t-icon name="share-1" size="40rpx" color="#666" />
    </button>

    <!-- 待付款 -->
    <template wx:if="{{order.status === 'pending_payment'}}">
      <view class="action-bar__btn action-bar__btn--outline" bindtap="onCancel">取消订单</view>
      <view class="action-bar__btn action-bar__btn--primary" bindtap="onPay">立即支付</view>
    </template>

    <!-- 已发货/已送达 -->
    <template wx:elif="{{order.status === 'shipped' || order.status === 'delivered' || order.status === 'ready'}}">
      <view class="action-bar__btn action-bar__btn--outline" bindtap="onBuyAgain">再次购买</view>
      <view class="action-bar__btn action-bar__btn--primary" bindtap="onConfirmReceipt">确认收货</view>
    </template>

    <!-- 已付款 (待发货) -->
    <template wx:elif="{{order.status === 'paid' || order.status === 'preparing'}}">
      <view class="action-bar__btn action-bar__btn--outline" bindtap="onCancel">取消订单</view>
    </template>
  </view>

  <!-- 已完成操作栏 -->
  <view class="action-bar safe-bottom-fixed" wx:elif="{{order.status === 'completed'}}">
    <button class="action-bar__share" open-type="share">
      <t-icon name="share-1" size="40rpx" color="#666" />
    </button>
    <view class="action-bar__btn action-bar__btn--outline" bindtap="onReview">去评价</view>
    <view class="action-bar__btn action-bar__btn--primary" bindtap="onBuyAgain">再次购买</view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-page" wx:if="{{loading}}">
  <t-loading theme="circular" size="48rpx" text="加载中..." />
</view>
