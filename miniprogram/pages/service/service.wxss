/* pages/service/service.wxss — AI Smart Customer Service */

.service-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f5f2;
}

/* ── Header ── */
.service-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}

.service-header-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.service-header-info {
  flex: 1;
}

.service-header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.3;
}

.service-header-sub {
  font-size: 24rpx;
  color: #52c41a;
  margin-top: 4rpx;
}

.service-header-call {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  background: #fdf5ee;
  font-size: 24rpx;
  color: #835C45;
}

/* ── Chat Body ── */
.chat-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx;
}

/* ── Quick FAQs ── */
.quick-faqs {
  margin-bottom: 24rpx;
}

.faq-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.faq-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.faq-chip {
  padding: 14rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e8e4e0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #835C45;
  transition: all 0.2s;
}

.faq-chip:active {
  background: #fdf5ee;
  border-color: #835C45;
}

/* ── Messages ── */
.msg-list {
  display: flex;
  flex-direction: column;
}

.msg-item {
  display: flex;
  margin-bottom: 28rpx;
  max-width: 100%;
}

.msg-user {
  justify-content: flex-end;
}

.msg-bot {
  justify-content: flex-start;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fdf5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.msg-user .msg-avatar {
  margin-left: 12rpx;
  background: #f0f0f0;
}

.msg-bot .msg-avatar {
  margin-right: 12rpx;
}

.msg-bubble-wrap {
  max-width: 80%;
  display: flex;
  flex-direction: column;
}

.msg-bubble {
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.bubble-user {
  background: #835C45;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.bubble-bot {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ── Follow-up chip ── */
.msg-followup {
  margin-top: 10rpx;
}

.followup-chip {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 20rpx;
  background: #fff;
  border: 1rpx solid #835C45;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #835C45;
}

.msg-user .msg-bubble-wrap {
  align-items: flex-end;
}

.msg-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
  text-align: center;
}

/* ── Typing Indicator ── */
.typing-bubble {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 22rpx 28rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* ── Input Bar ── */
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.chat-input-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.chat-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.input-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.chat-send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.chat-send-btn.active {
  background: #835C45;
}
