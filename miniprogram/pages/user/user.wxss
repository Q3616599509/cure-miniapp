/* pages/user/user.wxss */
.user-page {
  min-height: 100vh;
  background: var(--cure-bg-page);
  padding-bottom: 40rpx;
}

/* ── Header ── */
.user-header {
  position: relative;
  overflow: hidden;
}

.user-header-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, var(--cure-primary) 0%, var(--cure-primary-light) 100%);
}

.user-header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 80rpx 32rpx 24rpx;
}

.user-avatar,
.user-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-icon {
  font-size: 56rpx;
}

.user-info {
  margin-left: 24rpx;
  flex: 1;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.login-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.login-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.user-level {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--cure-radius-full);
}

.level-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.level-text {
  font-size: 22rpx;
  color: #fff;
}

.level-arrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 4rpx;
}

/* ── Stats Row ── */
.stats-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #fff;
  margin: 0 24rpx;
  border-radius: var(--cure-radius-lg);
  padding: 28rpx 0;
  box-shadow: var(--cure-shadow-md);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cure-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--cure-border);
}

/* ── Section ── */
.section {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--cure-radius-lg);
  padding: 28rpx;
  box-shadow: var(--cure-shadow-sm);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
}

/* ── Order Grid ── */
.order-grid {
  display: flex;
  justify-content: space-around;
}

.order-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}

.order-grid-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.order-grid-label {
  font-size: 24rpx;
  color: var(--cure-text-primary);
}

/* ── Function Grid ── */
.func-grid {
  display: flex;
  flex-wrap: wrap;
}

.func-grid-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.func-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.func-name {
  font-size: 24rpx;
  color: var(--cure-text-primary);
}

/* ── Footer ── */
.footer-version {
  text-align: center;
  font-size: 22rpx;
  color: var(--cure-text-placeholder);
  padding: 40rpx 0 20rpx;
}
