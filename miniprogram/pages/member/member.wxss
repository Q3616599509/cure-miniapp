/* pages/member/member.wxss */
.member-page {
  min-height: 100vh;
  background: var(--cure-bg-page);
  padding-bottom: 40rpx;
}

/* ── Not Logged In ── */
.not-logged-in {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cure-bg-page);
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx;
}

.login-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
}

.login-desc {
  font-size: 26rpx;
  color: var(--cure-text-secondary);
  margin-top: 12rpx;
  text-align: center;
}

/* ── Member Card ── */
.member-card {
  position: relative;
  margin: 24rpx;
  border-radius: var(--cure-radius-xl);
  overflow: hidden;
  box-shadow: var(--cure-shadow-lg);
}

.member-card-bg-pattern {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.member-card-content {
  position: relative;
  z-index: 1;
  padding: 40rpx;
}

.member-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-card-level {
  display: flex;
  align-items: center;
}

.level-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.level-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.member-card-points {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.points-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.points-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

/* ── Growth Bar ── */
.growth-section {
  margin-top: 40rpx;
}

.growth-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.growth-current,
.growth-next,
.growth-max {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.growth-bar-track {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 6rpx;
  overflow: hidden;
}

.growth-bar-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.member-card-footer {
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.card-no {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

/* ── Quick Entries ── */
.quick-entries {
  display: flex;
  background: #fff;
  margin: 0 24rpx;
  border-radius: var(--cure-radius-lg);
  padding: 32rpx 0;
  box-shadow: var(--cure-shadow-sm);
  margin-top: -12rpx;
  position: relative;
  z-index: 2;
}

.quick-entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-entry-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.quick-entry-text {
  font-size: 26rpx;
  color: var(--cure-text-primary);
  font-weight: 500;
}

/* ── Section ── */
.section {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--cure-radius-lg);
  padding: 28rpx;
  box-shadow: var(--cure-shadow-sm);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
}

/* ── Benefits Grid ── */
.benefits-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.benefit-card {
  width: calc(50% - 12rpx);
  background: #faf8f6;
  border-radius: var(--cure-radius-md);
  padding: 24rpx;
  text-align: center;
}

.benefit-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.benefit-label {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
  margin-bottom: 4rpx;
}

.benefit-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cure-primary);
}

/* ── Level Ladder ── */
.level-ladder {
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow-x: auto;
}

.level-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: var(--cure-radius-md);
  min-width: 100rpx;
  opacity: 0.5;
}

.level-item.current {
  background: rgba(131, 92, 69, 0.08);
  opacity: 1;
}

.level-badge {
  font-size: 36rpx;
}

.level-name-text {
  font-size: 22rpx;
  color: var(--cure-text-primary);
  margin-top: 4rpx;
  font-weight: 500;
}

.level-growth {
  font-size: 20rpx;
  color: var(--cure-text-placeholder);
  margin-top: 2rpx;
}

.level-arrow {
  font-size: 24rpx;
  color: var(--cure-text-placeholder);
}

/* ── Points Log ── */
.points-log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.points-log-item:last-child {
  border-bottom: none;
}

.points-log-desc {
  font-size: 28rpx;
  color: var(--cure-text-primary);
}

.points-log-time {
  font-size: 22rpx;
  color: var(--cure-text-placeholder);
  margin-top: 4rpx;
}

.points-log-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.points-log-amount.earn {
  color: var(--cure-success);
}

.points-log-amount.spend {
  color: var(--cure-error);
}

/* ── Loading ── */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}
