/* pages/index/index.wxss — 首页样式 */
.home {
  min-height: 100vh;
  background: var(--color-bg);
}

/* ── 导航栏 ─────────────────────────────────────────── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: #fff;
  box-shadow: 0 1rpx 0 var(--color-border-light);
}

.nav-bar__content {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  gap: 16rpx;
}

.nav-bar__logo {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: -1rpx;
  flex-shrink: 0;
}

.nav-bar__search {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  background: var(--color-bg);
  border-radius: 32rpx;
  padding: 0 24rpx;
  gap: 12rpx;
}

.nav-bar__search-text {
  font-size: 26rpx;
  color: var(--color-text-placeholder);
}

.nav-bar__scan {
  flex-shrink: 0;
  padding: 8rpx;
}

/* ── 滚动容器 ───────────────────────────────────────── */
.home-scroll {
  height: calc(100vh - 88rpx - env(safe-area-inset-top));
  box-sizing: border-box;
}

/* ── Banner ─────────────────────────────────────────── */
.banner-section {
  padding: 16rpx 24rpx 0;
}

.banner-swiper {
  height: 320rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-xl);
  overflow: hidden;
}

/* ── 品类导航 ────────────────────────────────────────── */
.category-section {
  margin: 24rpx;
  padding: 24rpx 16rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.category-item__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.category-item__name {
  font-size: 24rpx;
  color: var(--color-text-regular);
}

/* ── 限时抢购 ────────────────────────────────────────── */
.flash-sale-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-header__left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-header__title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-header__title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-header__bar {
  width: 8rpx;
  height: 32rpx;
  background: var(--color-primary);
  border-radius: 4rpx;
}

.section-header__more {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.countdown {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.countdown__box {
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: var(--color-text-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 6rpx;
  font-family: 'Courier New', monospace;
}

.countdown__colon {
  font-size: 24rpx;
  color: var(--color-text-primary);
  font-weight: 700;
}

.flash-sale-scroll {
  white-space: nowrap;
}

.flash-sale-list {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.flash-sale-item {
  display: inline-flex;
  flex-direction: column;
  width: 180rpx;
  flex-shrink: 0;
}

.flash-sale-item__name {
  font-size: 24rpx;
  color: var(--color-text-regular);
  margin-top: 12rpx;
  max-width: 180rpx;
}

.flash-sale-item__price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-top: 4rpx;
}

.flash-sale-item__price-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* ── 热销推荐 ────────────────────────────────────────── */
.hot-section {
  padding: 0 24rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 340rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.product-card__image-wrap {
  position: relative;
  width: 100%;
  height: 340rpx;
}

.product-card__image {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
  background: #f5f0eb;
  display: block;
}

.product-card__tags {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  display: flex;
  gap: 8rpx;
}

.product-card__info {
  padding: 16rpx 20rpx 20rpx;
}

.product-card__name {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.4;
  height: 72rpx;
  overflow: hidden;
}

.product-card__bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product-card__price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.product-card__sales {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}

/* ── 加载更多 ────────────────────────────────────────── */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
}

.load-more__text {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

/* ── 悬浮购物车 ──────────────────────────────────────── */
.float-cart {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 92, 57, 0.4);
  z-index: 100;
}

.float-cart__badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: var(--color-danger);
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  padding: 0 8rpx;
  border: 2rpx solid #fff;
}

/* ── 图片加载失败占位 ───────────────────────────────── */
.image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  border-radius: 16rpx;
}

.image-fallback--small {
  border-radius: 12rpx;
}
