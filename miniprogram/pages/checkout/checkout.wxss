/* pages/checkout/checkout.wxss */

.checkout-page {
  min-height: 100vh;
  background: var(--cure-bg-page);
}

/* ── Nav Bar ── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  box-shadow: var(--cure-shadow-sm);
}

.nav-bar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 60rpx;
}

/* ── Section ── */
.section {
  background: #fff;
  margin: 16rpx;
  border-radius: var(--cure-radius-lg);
  padding: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
  margin-bottom: 16rpx;
}

/* ── Store ── */
.store-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.store-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cure-primary);
}

.store-addr {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
}

/* ── Items ── */
.item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item:last-child {
  border-bottom: none;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--cure-radius-md);
  flex-shrink: 0;
  background: #f5f5f5;
}

.item-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cure-text-primary);
  line-height: 1.4;
}

.item-spec {
  font-size: 22rpx;
  color: var(--cure-text-placeholder);
  margin-top: 4rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 28rpx;
}

.item-qty {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
}

/* ── Price ── */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--cure-text-secondary);
}

.price-discount {
  color: var(--cure-error);
}

.price-total {
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
  padding-top: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
}

.cure-price-large {
  font-size: 36rpx;
}

/* ── Bottom Bar ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  z-index: 90;
}

.bottom-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bottom-label {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
}

/* ── Success Overlay ── */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.success-card {
  background: #fff;
  border-radius: var(--cure-radius-xl);
  padding: 48rpx 40rpx;
  text-align: center;
  width: 100%;
  max-width: 600rpx;
}

.success-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--cure-text-primary);
  margin-bottom: 12rpx;
}

.success-amount {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--cure-primary);
  margin-bottom: 16rpx;
}

.success-info {
  font-size: 24rpx;
  color: var(--cure-text-secondary);
  margin-bottom: 24rpx;
}

.success-steps {
  text-align: left;
  background: #f8f5f2;
  border-radius: var(--cure-radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 32rpx;
}

.step {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.step:first-child {
  border-bottom: 1rpx solid #e8e3de;
}

.step-tag {
  color: var(--cure-primary);
  font-weight: 500;
  margin-right: 12rpx;
  white-space: nowrap;
}

.step-text {
  color: var(--cure-text-secondary);
}

.success-actions {
  display: flex;
  flex-direction: column;
}
