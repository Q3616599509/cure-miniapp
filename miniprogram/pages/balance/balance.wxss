/* pages/balance/balance.wxss */
.balance-page {
  min-height: 100vh;
  background: var(--cure-bg-page);
  padding-bottom: 40rpx;
}

/* ── Not Logged In ── */
.not-logged-in {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 32rpx;
  color: var(--cure-text-secondary);
}

/* ── Balance Header ── */
.balance-header {
  position: relative;
  overflow: hidden;
  padding: 64rpx 32rpx;
}

.balance-header-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, var(--cure-primary) 0%, var(--cure-primary-light) 100%);
}

.balance-header-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.balance-value {
  font-size: 80rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 8rpx;
  line-height: 1.2;
}

/* ── Section ── */
.section {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--cure-radius-lg);
  padding: 28rpx;
  box-shadow: var(--cure-shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
  margin-bottom: 20rpx;
}

/* ── Recharge Grid ── */
.recharge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.recharge-card {
  width: calc(50% - 8rpx);
  border: 2rpx solid var(--cure-border);
  border-radius: var(--cure-radius-md);
  padding: 28rpx 0;
  text-align: center;
  transition: all 0.2s;
  position: relative;
}

.recharge-card.active {
  border-color: var(--cure-primary);
  background: rgba(131, 92, 69, 0.05);
}

.recharge-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
}

.recharge-card.active .recharge-amount {
  color: var(--cure-primary);
}

.recharge-bonus {
  font-size: 22rpx;
  color: var(--cure-error);
  margin-top: 4rpx;
}

/* ── Transaction List ── */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.transaction-list {
  display: flex;
  flex-direction: column;
}

.transaction-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.transaction-info {
  flex: 1;
  min-width: 0;
}

.transaction-desc {
  font-size: 28rpx;
  color: var(--cure-text-primary);
  font-weight: 500;
}

.transaction-time {
  font-size: 22rpx;
  color: var(--cure-text-placeholder);
  margin-top: 4rpx;
}

.transaction-amount {
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.transaction-amount.income {
  color: var(--cure-success);
}

.transaction-amount.expense {
  color: var(--cure-text-primary);
}
