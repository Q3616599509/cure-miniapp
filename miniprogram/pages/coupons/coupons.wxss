/* pages/coupons/coupons.wxss */
.coupons-page {
  min-height: 100vh;
  background: var(--cure-bg-page);
}

/* ── Coupon List ── */
.coupon-list {
  padding: 16rpx 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.login-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

/* ── Coupon Card ── */
.coupon-card {
  display: flex;
  background: #fff;
  border-radius: var(--cure-radius-lg);
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: var(--cure-shadow-sm);
  position: relative;
}

.coupon-card.used,
.coupon-card.expired {
  opacity: 0.55;
}

.coupon-left {
  width: 220rpx;
  background: linear-gradient(135deg, var(--cure-primary) 0%, var(--cure-primary-light) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  flex-shrink: 0;
}

.coupon-left.discount {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
}

.coupon-left.free {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
}

.coupon-value {
  display: flex;
  align-items: baseline;
  color: #fff;
}

.value-symbol {
  font-size: 28rpx;
  font-weight: 600;
}

.value-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.value-text {
  font-size: 36rpx;
  font-weight: 700;
}

.coupon-type-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.coupon-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cure-text-primary);
  margin-bottom: 4rpx;
}

.coupon-threshold {
  font-size: 26rpx;
  color: var(--cure-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.coupon-desc {
  font-size: 22rpx;
  color: var(--cure-text-placeholder);
  margin-bottom: 4rpx;
}

.coupon-valid,
.coupon-expire {
  font-size: 22rpx;
  color: var(--cure-text-placeholder);
  margin-bottom: 8rpx;
}

.coupon-status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--cure-radius-sm);
  background: #f0f0f0;
  font-size: 22rpx;
  color: var(--cure-text-secondary);
  align-self: flex-start;
}

/* ── Coupon Split (dashed line) ── */
.coupon-split {
  position: absolute;
  left: 220rpx;
  top: 0;
  bottom: 0;
  width: 0;
  border-left: 2rpx dashed #e0e0e0;
}

.coupon-split::before,
.coupon-split::after {
  content: '';
  position: absolute;
  left: -10rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--cure-bg-page);
}

.coupon-split::before {
  top: -10rpx;
}

.coupon-split::after {
  bottom: -10rpx;
}

/* ── Filter Bar ── */
.filter-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: var(--cure-radius-full);
  font-size: 26rpx;
  color: var(--cure-text-secondary);
  background: #f5f5f5;
  transition: all 0.2s;
}

.filter-item.active {
  background: var(--cure-primary);
  color: #fff;
  font-weight: 500;
}

/* ── My Coupon List ── */
.my-coupon-list {
  padding-top: 8rpx;
}
