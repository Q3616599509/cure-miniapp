/* pages/order-list/order-list.wxss — 订单列表页样式 */
.order-list-page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* ── Tab 栏 ──────────────────────────────────────────── */
.tabs-bar {
  display: flex;
  align-items: center;
  background: #fff;
  height: 88rpx;
  padding: 0 8rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

.tab-item__text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transition: color 0.2s;
}

.tab-item--active .tab-item__text {
  color: var(--color-text-primary);
  font-weight: 600;
}

.tab-item__line {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

/* ── 订单列表 ────────────────────────────────────────── */
.order-list {
  padding: 24rpx;
}

/* ── 订单卡片 ────────────────────────────────────────── */
.order-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.order-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.order-card__no {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.order-card__status {
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ── 卡片主体 ────────────────────────────────────────── */
.order-card__body {
  padding: 20rpx 0;
}

.order-card__images {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.order-card__img-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg);
}

.order-card__img {
  width: 100%;
  height: 100%;
}

.order-card__no-img {
  flex: 1;
  display: flex;
  align-items: center;
  min-height: 140rpx;
}

.order-card__item-name {
  font-size: 28rpx;
  color: var(--color-text-regular);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.order-card__summary {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.order-card__count {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
  margin-right: 8rpx;
}

.order-card__price-wrap {
  display: flex;
  align-items: baseline;
}

.order-card__price-label {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
  margin-right: 4rpx;
}

.order-card__price {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

/* ── 卡片底部操作 ────────────────────────────────────── */
.order-card__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.order-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 40rpx;
  line-height: 1.4;
  transition: opacity 0.2s;
}

.order-btn:active {
  opacity: 0.7;
}

.order-btn--outline {
  background: #fff;
  color: var(--color-text-regular);
  border: 2rpx solid var(--color-border);
}

.order-btn--primary {
  background: linear-gradient(135deg, #FF5C39, #FF3B3B);
  color: #fff;
  font-weight: 600;
  border: none;
}

/* ── 加载更多 ────────────────────────────────────────── */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
}

.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
}

.no-more__text {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

/* ── 加载中 ──────────────────────────────────────────── */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
}

/* ── 空状态 ──────────────────────────────────────────── */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
  padding: 60rpx 0;
}

.empty-tip {
  font-size: 26rpx;
  color: var(--color-text-placeholder);
  margin-top: 24rpx;
}
